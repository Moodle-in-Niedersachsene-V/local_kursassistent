{{!
    @template local_kursassistent/guide_page

    Guide for teachers.

    Context variables required for this template:
    * empty - True if the administrator has not written a guide yet
    * content - The guide as HTML, already sanitised by format_text()
    * backurl - Link back to the course

    Example context (json):
    {
        "empty": false,
        "content": "<p>Open the assistant in the course.</p>",
        "backurl": "https://example.org/course/view.php?id=2"
    }
}}
{{#empty}}
<p class="text-muted">{{#str}} anleitung_leer, local_kursassistent {{/str}}</p>
{{/empty}}
{{^empty}}
<div>{{{content}}}</div>
{{/empty}}
<div class="mt-3">
    <a href="{{backurl}}" class="btn btn-secondary">{{#str}} zurueckzumkurs, local_kursassistent {{/str}}</a>
</div>
