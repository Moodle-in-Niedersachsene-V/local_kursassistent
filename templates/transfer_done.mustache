{{!
    @template local_kursassistent/transfer_done

    Success message after a course template was applied.

    Context variables required for this template:
    * message - The success text
    * backurl - Link back to the course, carries the result for the assistant

    Example context (json):
    {
        "message": "The template Course in German was applied.",
        "backurl": "https://example.org/course/view.php?id=2&kaergebnis=vorlage"
    }
}}
<div class="alert alert-success" role="alert">{{message}}</div>
<div class="mt-3">
    <a href="{{backurl}}" class="btn btn-primary">{{#str}} zurueckzumkurs, local_kursassistent {{/str}}</a>
</div>
