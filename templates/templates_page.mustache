{{!
    @template local_kursassistent/templates_page

    Selection of the course templates.

    Context variables required for this template:
    * backurl - Link back to the course
    * notconfigured - True if no template category is configured
    * empty - True if the category holds no templates
    * items - List of templates: title, summary, imageurl, selecturl

    Example context (json):
    {
        "backurl": "https://example.org/course/view.php?id=2",
        "notconfigured": false,
        "empty": false,
        "items": [
            {
                "title": "Course in German",
                "summary": "A ready-made course with three sections.",
                "imageurl": "https://example.org/pluginfile.php/1/course/overviewfiles/image.png",
                "selecturl": "https://example.org/local/kursassistent/vorlagen.php?courseid=2&templateid=5"
            }
        ]
    }
}}
{{#notconfigured}}
<div class="alert alert-info" role="alert">{{#str}} vorlagen_nichtkonfiguriert, local_kursassistent {{/str}}</div>
{{/notconfigured}}
{{^notconfigured}}
    {{#empty}}
    <div class="alert alert-info" role="alert">{{#str}} vorlagen_leer, local_kursassistent {{/str}}</div>
    {{/empty}}
    {{^empty}}
    <p>{{#str}} vorlagen_hinweis, local_kursassistent {{/str}}</p>
    <div class="local-kursassistent-vorlagen">
        {{#items}}
        <div class="local-kursassistent-vorlage">
            {{#imageurl}}
            <img src="{{imageurl}}" alt="" class="local-kursassistent-vorlage-bild">
            {{/imageurl}}
            {{^imageurl}}
            <div class="local-kursassistent-vorlage-bild local-kursassistent-vorlage-leer"></div>
            {{/imageurl}}
            <h5 class="local-kursassistent-vorlage-titel">{{title}}</h5>
            {{#summary}}
            <p class="local-kursassistent-vorlage-text">{{summary}}</p>
            {{/summary}}
            <a href="{{selecturl}}" class="btn btn-primary btn-sm">{{#str}} vorlagen_auswaehlen, local_kursassistent {{/str}}</a>
        </div>
        {{/items}}
    </div>
    {{/empty}}
{{/notconfigured}}
<div class="mt-3">
    <a href="{{backurl}}" class="btn btn-secondary">{{#str}} zurueckzumkurs, local_kursassistent {{/str}}</a>
</div>
