{{!
    @template local_kursassistent/progress_modal

    Window "My progress" for students: own completion progress of the course.

    Context variables required for this template:
    * notenabled - True if completion tracking is switched off in the course
    * empty - True if the course has no activities with completion tracking
    * showcontent - True if the progress is shown
    * percent - Completed share in percent, 0 to 100
    * barclass - CSS class for the colour of the bar
    * completedcount - Number of completed activities
    * totalcount - Number of activities with completion tracking
    * hasnextstep, nextstep - The next step (name, url, hasurl, duetext, status, statuslabel)
    * hasoverdue, overdue - Overdue activities (name, url, hasurl, duetext)
    * sections - Sections: sectionname, sectionkey, donecount, totalcount, expanded, activities
      (modname, name, completed, status, statuslabel, showprogress, grade, teachernote)
    * teachercomment - Optional note of the teacher, plain text
    * hasinfos, infos - Course infos of the teacher: infotext, authorname, timetext

    Example context (json):
    {
        "notenabled": false,
        "empty": false,
        "showcontent": true,
        "percent": 50,
        "barclass": "local-kursassistent-bar-mid",
        "completedcount": 1,
        "totalcount": 2,
        "hasnextstep": true,
        "nextstep": {"name": "Forum", "url": "https://example.com/mod/forum/view.php?id=3", "hasurl": true, "duetext": "22.10.26", "status": "open", "statuslabel": "open"},
        "hasoverdue": false,
        "overdue": [],
        "sections": [
            {
                "sectionname": "Topic 1",
                "sectionkey": "sec1",
                "donecount": 1,
                "totalcount": 2,
                "expanded": true,
                "activities": [
                    {"modname": "assign", "name": "Task 1", "completed": true, "status": "done", "statuslabel": "done", "grade": "85,00", "teachernote": "Clean solution."},
                    {"modname": "forum", "name": "Forum", "completed": false, "status": "open", "statuslabel": "open"}
                ]
            }
        ],
        "teachercomment": "Well done so far.",
        "hasinfos": true,
        "infos": [{"infotext": "Test on Friday.", "authorname": "Max Teacher", "timetext": "20.10.26, 08:15"}]
    }
}}
<div class="local-kursassistent-overlay">
    <div class="local-kursassistent-modal">
        <div class="d-flex align-items-center justify-content-between mb-3 local-kursassistent-header">
            <p class="font-weight-bold mb-0">{{#str}} meinfortschritt, local_kursassistent {{/str}}</p>
            <button type="button" class="close local-kursassistent-progress-close" aria-label="{{#str}} closebuttontitle, core {{/str}}">&times;</button>
        </div>
        {{#hasinfos}}
        <div class="local-kursassistent-teacher-comment mb-3 px-3 py-2">
            <div class="small font-weight-bold mb-1">{{#str}} kursinfo_title, local_kursassistent {{/str}}</div>
            {{#infos}}
            <div class="mb-2">
                <div class="local-kursassistent-info-text">{{infotext}}</div>
                <div class="small text-muted">{{authorname}} · {{timetext}}</div>
            </div>
            {{/infos}}
        </div>
        {{/hasinfos}}
        {{#notenabled}}
        <div class="alert alert-info">{{#str}} progress_notenabled, local_kursassistent {{/str}}</div>
        {{/notenabled}}
        {{#empty}}
        <div class="alert alert-info">{{#str}} progress_noactivities, local_kursassistent {{/str}}</div>
        {{/empty}}
        {{#showcontent}}
        <div class="local-kursassistent-stat-summary mb-3 p-3">
            <div class="local-kursassistent-stat-headline">
                <span class="local-kursassistent-stat-percent">{{percent}}%</span>
                <span> {{#str}} progress_completed, local_kursassistent {{/str}}</span>
            </div>
            <div class="small text-muted mt-1">{{#str}} progress_counts, local_kursassistent, {"done": {{completedcount}}, "total": {{totalcount}}} {{/str}}</div>
            <div class="local-kursassistent-bar-track">
                <div class="local-kursassistent-bar-fill {{barclass}}" style="width:{{percent}}%"></div>
            </div>
        </div>
        {{#hasnextstep}}
        <div class="local-kursassistent-next-step d-flex flex-wrap align-items-center mb-3 p-3">
            <div class="flex-grow-1">
                <div class="small font-weight-bold text-uppercase">{{#str}} progress_nextstep, local_kursassistent {{/str}}</div>
                <div class="font-weight-bold">{{nextstep.name}}</div>
                {{#nextstep.duetext}}<div class="small text-muted">{{#str}} progress_due, local_kursassistent, {{nextstep.duetext}} {{/str}}</div>{{/nextstep.duetext}}
            </div>
            {{#nextstep.hasurl}}
            <a class="btn btn-primary" href="{{nextstep.url}}">{{#str}} progress_open, local_kursassistent {{/str}}</a>
            {{/nextstep.hasurl}}
        </div>
        {{/hasnextstep}}
        {{#hasoverdue}}
        <div class="local-kursassistent-overdue-box mb-3 p-3">
            <p class="font-weight-bold mb-2">{{#str}} status_overdue, local_kursassistent {{/str}}</p>
            {{#overdue}}
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-1">
                <span>{{#hasurl}}<a href="{{url}}">{{name}}</a>{{/hasurl}}{{^hasurl}}{{name}}{{/hasurl}}
                    {{#duetext}}<span class="small text-muted"> · {{#str}} progress_due, local_kursassistent, {{duetext}} {{/str}}</span>{{/duetext}}</span>
                <span class="local-kursassistent-pill local-kursassistent-pill-overdue">{{#str}} status_overdue, local_kursassistent {{/str}}</span>
            </div>
            {{/overdue}}
        </div>
        {{/hasoverdue}}
        {{#sections}}
        <div class="mt-3 mb-1">
            <button type="button" class="btn btn-block d-flex align-items-center px-3 local-kursassistent-section-toggle"
                aria-expanded="{{#expanded}}true{{/expanded}}{{^expanded}}false{{/expanded}}" aria-controls="local-kursassistent-{{sectionkey}}">
                <i class="icon fa {{#expanded}}fa-chevron-down{{/expanded}}{{^expanded}}fa-chevron-right{{/expanded}} mr-2 local-kursassistent-section-icon" aria-hidden="true"></i>
                <span class="flex-grow-1">{{sectionname}}</span>
                <span class="small">{{#str}} progress_counts, local_kursassistent, {"done": {{donecount}}, "total": {{totalcount}}} {{/str}}</span>
            </button>
        </div>
        <div id="local-kursassistent-{{sectionkey}}" class="{{^expanded}}d-none{{/expanded}}">
        {{#activities}}
        <div class="local-kursassistent-fortschritt-row d-flex align-items-center mb-1">
            <span class="small flex-grow-1">
                <span class="badge badge-secondary mr-1">{{modname}}</span>
                <span{{^completed}} class="text-muted"{{/completed}}>{{name}}</span>
            </span>
            {{#grade}}
            <span class="small font-weight-bold ml-2 text-nowrap">{{#str}} progress_result, local_kursassistent {{/str}}: {{grade}}</span>
            {{/grade}}
            <span class="local-kursassistent-pill local-kursassistent-pill-{{status}} ml-2">{{statuslabel}}</span>
        </div>
        {{#teachernote}}
        <div class="local-kursassistent-teacher-comment local-kursassistent-activity-note ml-4 mb-2 px-3 py-2">
            <div class="small font-weight-bold">{{#str}} progress_teachernote, local_kursassistent {{/str}}</div>
            <div class="small">{{teachernote}}</div>
        </div>
        {{/teachernote}}
        {{/activities}}
        </div>
        {{/sections}}
        {{#teachercomment}}
        <div class="local-kursassistent-teacher-comment mt-3 p-3">
            <div class="small font-weight-bold mb-1">{{#str}} progress_teachernote, local_kursassistent {{/str}}</div>
            <div class="small">{{teachercomment}}</div>
        </div>
        {{/teachercomment}}
        <div class="d-flex justify-content-end mt-3">
            <button type="button" class="btn btn-secondary local-kursassistent-progress-close">{{#str}} closebuttontitle, core {{/str}}</button>
        </div>
        {{/showcontent}}
    </div>
</div>
